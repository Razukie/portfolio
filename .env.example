# Copy this file to .env.local and fill in your keys, then restart `npm run dev`.

# EmailJS (https://dashboard.emailjs.com) — contact form sends straight to your inbox
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Alternative to EmailJS: a Formspree form URL (only used if EmailJS keys are empty)
NEXT_PUBLIC_CONTACT_ENDPOINT=
